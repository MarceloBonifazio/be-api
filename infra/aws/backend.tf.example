# State remoto (opt-in). Storage criado 1x por providers/aws/modules/tf-backend (S3+DynamoDB).
# Para ativar: renomeie p/ backend.tf e rode:
#   terraform init \
#     -backend-config="bucket=<seu-bucket>" \
#     -backend-config="region=sa-east-1" \
#     -backend-config="dynamodb_table=terraform-locks"
# Sem este arquivo (default), o state é LOCAL (terraform.tfstate).
terraform {
  backend "s3" {
    key     = "be-cep-api/aws.tfstate"
    encrypt = true
  }
}
