# State remoto (opt-in) — SEPARADO do app (key própria). Ative renomeando p/ backend.tf:
#   terraform init \
#     -backend-config="bucket=<seu-bucket>" \
#     -backend-config="region=sa-east-1" \
#     -backend-config="dynamodb_table=terraform-locks"
# Sem este arquivo (default), o state é LOCAL (terraform.tfstate).
terraform {
  backend "s3" {
    key     = "be-api/aws-resources.tfstate"
    encrypt = true
  }
}
