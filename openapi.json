{
  "openapi": "3.0.3",
  "info": {
    "title": "Nucleus Customers API",
    "version": "0.0.1"
  },
  "servers": [
    {
      "url": "/api/be-api"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/customers": {
      "get": {
        "summary": "Lista clientes",
        "description": "Requer USER ou ADMIN.",
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerPage"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos"
          },
          "401": {
            "description": "Token ausente ou inválido"
          },
          "403": {
            "description": "Sem autorização"
          },
          "404": {
            "description": "Cliente ou Score inexistente"
          },
          "409": {
            "description": "CPF duplicado ou conflito concorrente"
          }
        },
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0,
              "minimum": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "ACTIVE",
                "INACTIVE"
              ]
            }
          }
        ]
      },
      "post": {
        "summary": "Cadastra cliente e registra CUSTOMER_CREATED na outbox",
        "description": "Requer ADMIN.",
        "responses": {
          "201": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Customer"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos"
          },
          "401": {
            "description": "Token ausente ou inválido"
          },
          "403": {
            "description": "Sem autorização"
          },
          "404": {
            "description": "Cliente ou Score inexistente"
          },
          "409": {
            "description": "CPF duplicado ou conflito concorrente"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CustomerInput"
              }
            }
          }
        }
      }
    },
    "/customers/search": {
      "get": {
        "summary": "Busca parcial por nome, sem distinguir maiúsculas",
        "description": "Requer USER ou ADMIN.",
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerPage"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos"
          },
          "401": {
            "description": "Token ausente ou inválido"
          },
          "403": {
            "description": "Sem autorização"
          },
          "404": {
            "description": "Cliente ou Score inexistente"
          },
          "409": {
            "description": "CPF duplicado ou conflito concorrente"
          }
        },
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0,
              "minimum": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "name",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ]
      }
    },
    "/customers/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        }
      ],
      "get": {
        "summary": "Consulta cliente",
        "description": "Requer USER ou ADMIN.",
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Customer"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos"
          },
          "401": {
            "description": "Token ausente ou inválido"
          },
          "403": {
            "description": "Sem autorização"
          },
          "404": {
            "description": "Cliente ou Score inexistente"
          },
          "409": {
            "description": "CPF duplicado ou conflito concorrente"
          }
        }
      },
      "put": {
        "summary": "Altera cliente",
        "description": "Requer ADMIN.",
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Customer"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos"
          },
          "401": {
            "description": "Token ausente ou inválido"
          },
          "403": {
            "description": "Sem autorização"
          },
          "404": {
            "description": "Cliente ou Score inexistente"
          },
          "409": {
            "description": "CPF duplicado ou conflito concorrente"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CustomerInput"
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Exclui cliente",
        "description": "Requer ADMIN.",
        "responses": {
          "204": {
            "description": "Sucesso"
          },
          "400": {
            "description": "Dados inválidos"
          },
          "401": {
            "description": "Token ausente ou inválido"
          },
          "403": {
            "description": "Sem autorização"
          },
          "404": {
            "description": "Cliente ou Score inexistente"
          },
          "409": {
            "description": "CPF duplicado ou conflito concorrente"
          }
        }
      }
    },
    "/customers/{id}/score": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        }
      ],
      "get": {
        "summary": "Consulta Score pelo CPF do cliente",
        "description": "Requer USER ou ADMIN.",
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Score"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos"
          },
          "401": {
            "description": "Token ausente ou inválido"
          },
          "403": {
            "description": "Sem autorização"
          },
          "404": {
            "description": "Cliente ou Score inexistente"
          },
          "409": {
            "description": "CPF duplicado ou conflito concorrente"
          },
          "502": {
            "description": "Resposta inválida ou erro HTTP do serviço externo"
          },
          "503": {
            "description": "Serviço externo inacessível"
          },
          "504": {
            "description": "Timeout externo"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": [
          "contract"
        ],
        "summary": "Métricas Prometheus",
        "operationId": "metrics",
        "description": "Exposição das métricas operacionais no formato Prometheus.",
        "responses": {
          "200": {
            "description": "Exposição Prometheus (text/plain; version=0.0.4)",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "CustomerInput": {
        "type": "object",
        "required": [
          "name",
          "cpf",
          "email",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 150
          },
          "cpf": {
            "type": "string",
            "pattern": "^[0-9]{11}$"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE"
            ]
          }
        }
      },
      "Customer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string",
            "maxLength": 150
          },
          "cpf": {
            "type": "string",
            "pattern": "^[0-9]{11}$"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE"
            ]
          }
        }
      },
      "Score": {
        "type": "object",
        "properties": {
          "cpf": {
            "type": "string",
            "pattern": "^[0-9]{11}$"
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "classification": {
            "type": "string"
          }
        }
      },
      "CustomerPage": {
        "type": "object",
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Customer"
            }
          },
          "totalElements": {
            "type": "integer"
          },
          "totalPages": {
            "type": "integer"
          },
          "number": {
            "type": "integer"
          }
        }
      }
    }
  }
}
